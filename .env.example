# Triage/reply model. "offline" = deterministic rules (no network, used in CI). "openrouter" = live model.
LOPS_LLM_MODE=offline
LOPS_OPENROUTER_API_KEY=
LOPS_OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
LOPS_LLM_FALLBACK_TO_OFFLINE=true

# Money & hardware envelope (cents / counts). Everything the agent may do on its own is bounded here.
LOPS_MAX_AUTO_REFUND_CENTS=1000
LOPS_MAX_AUTO_REFUNDS_PER_USER_30D=3
LOPS_MAX_AUTO_REFUND_TOTAL_PER_USER_30D_CENTS=2000
LOPS_GOODWILL_CREDIT_CENTS=150
LOPS_RELAY_RETRIGGER_WINDOW_MIN=20
LOPS_RELAY_FAULT_THRESHOLD_7D=2

LOPS_DB_PATH=data/laundryops.sqlite
